{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub repository",
  "type": "object",
  "properties": {
    "fork": {
      "type": "object",
      "description": "Upstream repository to fork. Omit for an original repository.",
      "properties": {
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "not": {"enum": [".", ".."]}
        }
      },
      "required": ["owner", "repository"],
      "additionalProperties": false
    },
    "description": {
      "type": "string",
      "description": "A description of the repository"
    },
    "visibility": {
      "type": "string",
      "enum": ["private", "public", "internal"],
      "description": "The visibility level of the repository"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "A list of topics related to the repository"
    },
    "has_issues": {
      "type": "boolean",
      "description": "Enable GitHub Issues. Defaults to true in this template.",
      "default": true
    },
    "has_projects": {
      "type": "boolean",
      "description": "Enable GitHub Projects."
    },
    "has_wiki": {
      "type": "boolean",
      "description": "Enable the repository wiki."
    },
    "allow_auto_merge": {
      "type": "boolean",
      "description": "Allow automatic merging of pull requests."
    },
    "allow_merge_commit": {
      "type": "boolean",
      "description": "Allow merge commits."
    },
    "allow_rebase_merge": {
      "type": "boolean",
      "description": "Allow rebase merging."
    },
    "allow_squash_merge": {
      "type": "boolean",
      "description": "Allow squash merging."
    },
    "delete_branch_on_merge": {
      "type": "boolean",
      "description": "Automatically delete head branches after merging."
    },
    "homepage_url": {
      "type": "string",
      "description": "Repository homepage URL; an empty string clears it."
    },
    "permissions": {
      "type": "object",
      "properties": {
        "users": {
          "type": "object",
          "properties": {
            "pull": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "User ids with pull permissions"
            },
            "push": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "User ids with push permissions"
            },
            "maintain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "User ids with maintain permissions"
            },
            "triage": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "User ids with triage permissions"
            },
            "admin": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "User ids with admin permissions"
            }
          }
        },
        "teams": {
          "type": "object",
          "properties": {
            "pull": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Team ids with pull permissions"
            },
            "push": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Team ids with push permissions"
            },
            "maintain": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Team ids with maintain permissions"
            },
            "triage": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Team ids with triage permissions"
            },
            "admin": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Team ids with admin permissions"
            }
          }
        }
      }
    },
    "pages": {
      "type": "object",
      "properties": {
        "build_type": {
          "type": "string",
          "enum": ["workflow", "legacy"],
          "default": "workflow",
          "description": "The type of build (workflow or legacy)"
        },
        "cname": {
          "type": "string",
          "description": "The CNAME to use for the GitHub Pages"
        },
        "branch": {
          "type": "string",
          "default": "master",
          "description": "The branch to deploy from"
        },
        "path": {
          "type": "string",
          "enum": ["/", "/docs"],
          "default": "/",
          "description": "The path to deploy from (/ or /docs)"
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["visibility"],
  "additionalProperties": false
}
