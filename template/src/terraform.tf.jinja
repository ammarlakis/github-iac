terraform {
  required_version = "~> 1.9"

  required_providers {
    jsonschema = {
      source  = "iilei/jsonschema"
      version = "~> 0.6.4"
    }
    github = {
      source  = "integrations/github"
      version = "~> 6.13"
    }
    {% if import_existing %}
    local = {
      source  = "hashicorp/local"
      version = "~> 2.5"
    }
    {% endif %}
  }
}
