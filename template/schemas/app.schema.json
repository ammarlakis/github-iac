{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GitHub App",
  "type": "object",
  "properties": {
    "manifest": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "description": {
          "type": "string"
        },
        "public": {
          "type": "boolean"
        },
        "default_permissions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "read",
              "write"
            ]
          }
        },
        "default_events": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "hook_attributes": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://"
            },
            "active": {
              "type": "boolean"
            }
          },
          "required": [
            "url"
          ],
          "additionalProperties": false
        },
        "callback_urls": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://"
          }
        },
        "setup_url": {
          "type": "string",
          "pattern": "^https://"
        },
        "setup_on_update": {
          "type": "boolean"
        },
        "request_oauth_on_install": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "app_id": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "installation_id": {
      "type": "integer",
      "minimum": 1
    },
    "publisher": {
      "type": "boolean",
      "description": "Use this app to publish encrypted secrets; requires secrets write permission."
    },
    "secrets": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$"
        },
        "prefix": {
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "manifest"
      ]
    },
    {
      "required": [
        "installation_id"
      ]
    }
  ]
}
