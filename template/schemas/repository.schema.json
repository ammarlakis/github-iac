{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub repository",
  "type": "object",
  "$ref": "defs/repository-settings.schema.json",
  "properties": {
    "preset": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
      "description": "Preset name in data/presets, without the .yaml extension. Repository settings override the preset."
    }
  },
  "unevaluatedProperties": false
}
